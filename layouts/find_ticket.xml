<?xml version="1.0" encoding="utf-8"?>
<screen id="find_ticket" name="FindTicket">
  <toolbar>
    <backButton action="navigateBack" />
    <title bind="{ui.findTicketTitle}" />
    <filterButton icon="ic_filter" action="openFilters" />
  </toolbar>

  <routeSummaryCard>
    <origin bind="{filter.origin}" />
    <busIcon src="ic_bus" />
    <destination bind="{filter.destination}" />
    <dateTime>
      <time bind="{filter.departureTime}" />
      <date bind="{filter.departureDate}" format="dd/MM/yyyy" />
    </dateTime>
  </routeSummaryCard>

  <datePicker>
    <prevButton icon="ic_chevron_left" action="previousDate" />
    <selectedDate bind="{filter.date}" format="ddd, dd/MM/yyyy" />
    <nextButton icon="ic_chevron_right" action="nextDate" />
  </datePicker>

  <noticeBanner type="info" icon="ic_info_shield">
    <text bind="{ui.tripNotice}" />
  </noticeBanner>

  <tripResultsList>
    <tripCard repeat="{data.trips}" action="selectTrip">
      <operatorName bind="{trip.operator}" />
      <departureTime bind="{trip.departureTime}" />
      <busIconLabel icon="ic_bus_cabin" label="{trip.busType}" />
      <availability>
        <totalSeats bind="{trip.totalSeats}" />
        <availableSeats bind="{trip.availableSeats}" />
        <progressBar valueBind="{trip.soldSeats}" maxBind="{trip.totalSeats}" />
      </availability>
      <price amountBind="{trip.price}" currencyBind="{trip.currency}" style="highlight" />
    </tripCard>
  </tripResultsList>

  <navigation>
    <nextScreen on="selectTrip" target="choose_berth" />
  </navigation>
</screen>

