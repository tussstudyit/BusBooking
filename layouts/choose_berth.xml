<?xml version="1.0" encoding="utf-8"?>
<screen id="choose_berth" name="ChooseBerth">
  <toolbar>
    <backButton action="navigateBack" />
    <title bind="{ui.chooseBerthTitle}" />
    <homeButton icon="ic_home" action="navigateHome" />
  </toolbar>

  <routeSummaryCard>
    <origin bind="{trip.origin}" />
    <busIcon src="ic_bus" />
    <destination bind="{trip.destination}" />
    <dateTime bind="{trip.departureDateTime}" format="HH:mm dd/MM/yyyy" />
  </routeSummaryCard>

  <seatSelectionTabs>
    <tab id="tab_available" label="{ui.availableLabel}" icon="ic_seat_empty" state="active" />
    <tab id="tab_sold" label="{ui.soldLabel}" icon="ic_seat_sold" state="inactive" />
    <tab id="tab_selected" label="{ui.selectedLabel}" icon="ic_seat_selected" state="inactive" />
  </seatSelectionTabs>

  <seatLegend>
    <legendItem status="available" label="{ui.availableLabel}" icon="ic_seat_available" />
    <legendItem status="sold" label="{ui.soldLabel}" icon="ic_seat_sold" />
    <legendItem status="selecting" label="{ui.selectingLabel}" icon="ic_seat_selecting" />
  </seatLegend>

  <deckContainer orientation="vertical">
    <deck repeat="{seatMap.decks}" id="{deck.id}" label="{deck.label}">
      <seatGrid columns="3">
        <seatRow repeat="{deck.rows}">
          <seat repeat="{row.seats}"
                id="{seat.id}"
                status="{seat.status}"
                action="toggleSeat"
                icon="{seat.icon}" />
        </seatRow>
      </seatGrid>
    </deck>
  </deckContainer>

  <selectionSummaryBar>
    <selectionInfo>
      <ticketCount bind="{selection.count}" label="{ui.ticketsLabel}" />
      <duration bind="{trip.duration}" />
    </selectionInfo>
    <priceDisplay>
      <totalPrice amountBind="{selection.totalPrice}" currencyBind="{trip.currency}" />
    </priceDisplay>
  </selectionSummaryBar>

  <primaryButton label="{ui.nextButtonLabel}" action="proceedToPickup" style="filled" />

  <navigation>
    <nextScreen on="proceedToPickup" target="choose_pickup_dropoff" />
  </navigation>
</screen>

