rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked != true;
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /buses/{busId} {
      allow read: if true;
      allow write: if isAdmin();

      match /seats/{seatId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /trips/{tripId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tripSeats/{tripSeatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == 'PENDING_PAYMENT';
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == 'CREATED'
        && request.resource.data.provider == 'VNPAY';
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.isBlocked == resource.data.isBlocked;
      allow create, delete: if isAdmin();
    }

    match /phoneLogins/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
