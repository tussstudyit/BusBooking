<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Authentication Flow  →  AuthFragments.kt
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.busbooking.presentation.ui.SplashFragment"
        android:label="Splash Screen">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_nav_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.busbooking.presentation.ui.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/nav_home"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.busbooking.presentation.ui.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/nav_home"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Home Fragment (nav_home)  →  HomeFragment.kt
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.busbooking.presentation.ui.HomeFragment"
        android:label="Trang chu">
        <action
            android:id="@+id/action_homeFragment_to_ticketDetailsFragment"
            app:destination="@id/ticketDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_tripListFragment"
            app:destination="@id/tripListFragment" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════════════
         User Flow
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/routeSearchFragment"
        android:name="com.example.busbooking.presentation.ui.RouteSearchFragment"
        android:label="Search Routes">
        <action
            android:id="@+id/action_routeSearchFragment_to_tripListFragment"
            app:destination="@id/tripListFragment" />
    </fragment>

    <fragment
        android:id="@+id/myTicketsFragment"
        android:name="com.example.busbooking.presentation.ui.MyTicketsFragment"
        android:label="My Tickets">
        <action
            android:id="@+id/action_myTicketsFragment_to_ticketDetailsFragment"
            app:destination="@id/ticketDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingHistoryFragment"
        android:name="com.example.busbooking.presentation.ui.BookingHistoryFragment"
        android:label="Booking History" />

    <fragment
        android:id="@+id/ticketDetailsFragment"
        android:name="com.example.busbooking.presentation.ui.TicketDetailsFragment"
        android:label="Ticket Details">
        <argument
            android:name="ticketId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.example.busbooking.presentation.ui.UserProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_userProfileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_home"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Trip / Booking Flow  →  TripFlowFragments.kt
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/tripListFragment"
        android:name="com.example.busbooking.presentation.ui.TripListFragment"
        android:label="Available Trips">
        <action
            android:id="@+id/action_tripListFragment_to_tripDetailsFragment"
            app:destination="@id/tripDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripDetailsFragment"
        android:name="com.example.busbooking.presentation.ui.TripDetailsFragment"
        android:label="Trip Details">
        <argument
            android:name="tripId"
            app:argType="long" />
        <action
            android:id="@+id/action_tripDetailsFragment_to_seatSelectionFragment"
            app:destination="@id/seatSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/seatSelectionFragment"
        android:name="com.example.busbooking.presentation.ui.SeatSelectionFragment"
        android:label="Select Seats">
        <argument
            android:name="tripId"
            app:argType="long" />
        <action
            android:id="@+id/action_seatSelectionFragment_to_bookingConfirmationFragment"
            app:destination="@id/bookingConfirmationFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingConfirmationFragment"
        android:name="com.example.busbooking.presentation.ui.BookingConfirmationFragment"
        android:label="Confirm Booking">
        <argument
            android:name="ticketId"
            app:argType="long" />
        <action
            android:id="@+id/action_bookingConfirmationFragment_to_myTicketsFragment"
            app:destination="@id/myTicketsFragment"
            app:popUpTo="@id/nav_home"
            app:popUpToInclusive="false" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Admin Flow  →  AdminFlowFragments.kt
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.busbooking.presentation.ui.AdminDashboardFragment"
        android:label="Admin Dashboard">
        <action
            android:id="@+id/action_adminDashboardFragment_to_routeListAdminFragment"
            app:destination="@id/routeListAdminFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_busListAdminFragment"
            app:destination="@id/busListAdminFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_tripListAdminFragment"
            app:destination="@id/tripListAdminFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_ticketListAdminFragment"
            app:destination="@id/ticketListAdminFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_userListAdminFragment"
            app:destination="@id/userListAdminFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminProfileFragment"
            app:destination="@id/adminProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/ticketListAdminFragment"
        android:name="com.example.busbooking.presentation.ui.TicketListAdminFragment"
        android:label="Manage Tickets" />

    <fragment
        android:id="@+id/userListAdminFragment"
        android:name="com.example.busbooking.presentation.ui.UserListAdminFragment"
        android:label="Manage Users" />

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.example.busbooking.presentation.ui.AnalyticsFragment"
        android:label="Analytics" />

    <fragment
        android:id="@+id/adminProfileFragment"
        android:name="com.example.busbooking.presentation.ui.AdminProfileFragment"
        android:label="Admin Profile">
        <action
            android:id="@+id/action_adminProfileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/adminDashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Route Admin  →  RouteAdminFragments.kt
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/routeListAdminFragment"
        android:name="com.example.busbooking.presentation.ui.RouteListAdminFragment"
        android:label="Manage Routes">
        <action
            android:id="@+id/action_routeListAdminFragment_to_routeFormAdminFragment"
            app:destination="@id/routeFormAdminFragment" />
    </fragment>

    <fragment
        android:id="@+id/routeFormAdminFragment"
        android:name="com.example.busbooking.presentation.ui.RouteFormAdminFragment"
        android:label="Route Form">
        <argument
            android:name="routeId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Bus Admin  →  BusAdminFragments.kt
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/busListAdminFragment"
        android:name="com.example.busbooking.presentation.ui.BusListAdminFragment"
        android:label="Manage Buses">
        <action
            android:id="@+id/action_busListAdminFragment_to_busFormAdminFragment"
            app:destination="@id/busFormAdminFragment" />
        <action
            android:id="@+id/action_busListAdminFragment_to_seatManagementFragment"
            app:destination="@id/seatManagementFragment" />
    </fragment>

    <fragment
        android:id="@+id/busFormAdminFragment"
        android:name="com.example.busbooking.presentation.ui.BusFormAdminFragment"
        android:label="Bus Form">
        <argument
            android:name="busId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/seatManagementFragment"
        android:name="com.example.busbooking.presentation.ui.SeatManagementFragment"
        android:label="Manage Seats">
        <argument
            android:name="busId"
            app:argType="long" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Trip Admin  →  TripAdminFragments.kt
         ═══════════════════════════════════════════════════════════════════════ -->

    <fragment
        android:id="@+id/tripListAdminFragment"
        android:name="com.example.busbooking.presentation.ui.TripListAdminFragment"
        android:label="Manage Trips">
        <action
            android:id="@+id/action_tripListAdminFragment_to_tripFormAdminFragment"
            app:destination="@id/tripFormAdminFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripFormAdminFragment"
        android:name="com.example.busbooking.presentation.ui.TripFormAdminFragment"
        android:label="Trip Form">
        <argument
            android:name="tripId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

</navigation>