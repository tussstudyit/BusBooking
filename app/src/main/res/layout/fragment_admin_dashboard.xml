<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_grey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bảng điều khiển quản trị"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="20dp" />

        <!-- Grid các nút quản lý -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:layout_marginBottom="16dp">

            <!-- Quản lý tuyến đường -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageRoutesButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:text="Quản lý\nTuyến đường"
                android:layout_margin="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="@color/blue_primary"
                app:cornerRadius="12dp" />

            <!-- Quản lý xe buýt -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageBusesButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:text="Quản lý\nXe buýt"
                android:layout_margin="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="@color/blue_primary"
                app:cornerRadius="12dp" />

            <!-- Quản lý chuyến đi -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageTripsButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:text="Quản lý\nChuyến đi"
                android:layout_margin="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="@color/blue_primary"
                app:cornerRadius="12dp" />

            <!-- Quản lý vé -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageTicketsButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:text="Quản lý\nVé"
                android:layout_margin="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="@color/blue_primary"
                app:cornerRadius="12dp" />

            <!-- Quản lý người dùng -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageUsersButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:text="Quản lý\nNgười dùng"
                android:layout_margin="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="@color/blue_primary"
                app:cornerRadius="12dp" />

            <!-- Thống kê -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/analyticsButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:text="Thống kê"
                android:layout_margin="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="@color/blue_primary"
                app:cornerRadius="12dp" />

        </GridLayout>

        <!-- Nút hồ sơ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminProfileButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Hồ sơ quản trị"
            android:textSize="16sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/blue_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

