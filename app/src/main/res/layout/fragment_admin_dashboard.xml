<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/manageRoutesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Routes"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/manageBusesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Buses"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/manageTripsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Trips"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/manageTicketsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Tickets"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/manageUsersButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Users"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/analyticsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Analytics"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/adminProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profile"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LOGOUT"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>

