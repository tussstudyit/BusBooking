<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="staff_background">#F8FAFF</color>
    <color name="staff_blue">#2196F3</color>
    <color name="staff_blue_dark">#1E88E5</color>
    <color name="staff_danger">#E53935</color>
    <color name="staff_divider">#E4EAF4</color>
    <color name="staff_success">#21A67A</color>
    <color name="staff_surface">#FFFFFF</color>
    <color name="staff_text_primary">#172033</color>
    <color name="staff_text_secondary">#65718A</color>
    <color name="staff_warning">#F6A623</color>
    <dimen name="staff_bottom_nav_height">72dp</dimen>
    <string name="app_name">BusBooking Nhân viên</string>
    <string name="nav_home">Trang chủ</string>
    <string name="nav_profile">Tài khoản</string>
    <string name="nav_scan">Quét vé</string>
    <string name="nav_trips">Chuyến xe</string>
    <style name="Theme.BusBookingStaff" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/staff_blue</item>
        <item name="colorPrimaryVariant">@color/staff_blue_dark</item>
        <item name="colorAccent">@color/staff_blue_dark</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/staff_background</item>
        <item name="android:navigationBarColor">@color/staff_surface</item>
    </style>
    <style name="Theme.BusBookingStaff.Scanner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>